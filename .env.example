# Read-only Neon connection string (webapp_ro role). Required by
# netlify/functions/* and by the contract test scripts.
NEON_DATABASE_URL=

# Directory holding the scraper's production unified_courses.json and
# sessions.json pair. Set per device; the scraper writes here, the webapp
# contract tests read from here. Never a path inside this repository.
TUNNIPLAAN_DATA_DIR=

# Signing key for the "prove you are human" pass. Any long random string, and
# the same value on every deploy that serves data -- getCourses and
# humanVerification run as separate lambdas and must agree. Left blank, the
# functions derive a key from NEON_DATABASE_URL instead: that works, but it ties
# every outstanding pass to the database credential, so rotating one signs
# everybody out.
HUMAN_VERIFICATION_SECRET=

# Set to false to serve the dataset ungated. Any other value, including unset,
# leaves the gate on. Netlify only; the ChatGPT Site does not use this gate.
HUMAN_VERIFICATION_ENABLED=

# ChatGPT Sites only. Comma-separated email domains allowed to call /api/*.
# The worker's own default is taltech.ee when this is unset. `*` allows any
# signed-in address. Not read by the Netlify functions.
ALLOWED_EMAIL_DOMAINS=taltech.ee

# Optional session cap for getTimetable. Default 4000. On Sites this is read
# from the request env; on Netlify from the function environment.
CALENDAR_SESSION_LIMIT=
