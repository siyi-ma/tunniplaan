.vscode/
.claude/
.netlify/
.playwright-mcp/
.remember/
node_modules/
.DS_Store
Thumbs.db
*.log
.env
deno.lock

# Session data now lives in Neon Postgres (sessions table), not a bundled file.
# The scraper may still copy sessions.json here until its ingest plan lands;
# this guard keeps that stray copy from being re-committed.
sessions.json

# SDD review diffs are regenerable from the commit range recorded in each report.
docs/superpowers/sdd/*.diff

# Allow active distilled reference files
!docs/distilled-*.md

# Allow archive folder and its contents
!docs/archive/
!docs/archive/**

# Allow the three latest handoff files
!docs/*handoff*.md

